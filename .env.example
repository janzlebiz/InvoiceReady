# ==============================================================================
# InvoiceReady - Supabase & Vercel Environment Variables
# These variables are automatically injected when Supabase is connected to Vercel
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Public API Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (secret, for server-side admin functions if needed)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Gemini API Key (optional, for LLM-powered multi-format invoice extraction)
GEMINI_API_KEY=""

# Public Application URL (configured automatically on Vercel)
NEXT_PUBLIC_APP_URL="https://your-invoiceready-domain.vercel.app"
