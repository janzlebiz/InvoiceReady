# InvoiceReady v1.0 - Production Environment Configuration Template
# Conforms to Requirements 55, 56, 57.
#
# IMPORTANT: In production, secrets MUST NOT be stored in plaintext .env files.
# Mount production secrets securely via Google Secret Manager or Cloud Run secret environment bindings.

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
NODE_ENV="production"
PORT=3000
APP_URL="https://invoiceready.example.com"
ALLOW_TEST_AUTH="false"
ALLOW_TEST_SUITE="false"

# ==============================================================================
# 2. CLOUD SQL POSTGRESQL (Sole Authoritative Datastore)
# ==============================================================================
# Option A: Connection string via Secret Manager
DATABASE_URL="postgresql://invoiceready_user:PASSWORD@/invoiceready?host=/cloudsql/PROJECT:REGION:INSTANCE"

# Option B: Cloud SQL Auth Proxy Unix Socket Configuration
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_DB_NAME="invoiceready"
SQL_USER="invoiceready_user"
SQL_PASSWORD="STRONG_PASSWORD_FROM_SECRET_MANAGER"

# ==============================================================================
# 3. GOOGLE CLOUD STORAGE BUCKETS (Global Shared Object Storage)
# ==============================================================================
GOOGLE_CLOUD_PROJECT="my-gcp-project-id"
GCS_QUARANTINE_BUCKET="invoiceready-quarantine-prod"
GCS_PRIVATE_BUCKET="invoiceready-documents-prod"

# ==============================================================================
# 4. FIREBASE AUTHENTICATION (Server-Side Admin SDK)
# ==============================================================================
FIREBASE_PROJECT_ID="my-firebase-project-id"
# In Cloud Run, Workload Identity or Google Cloud Default Credentials authenticate Firebase Admin.
# For external environments, specify service account credentials:
# GOOGLE_APPLICATION_CREDENTIALS="/secrets/firebase-service-account.json"

# ==============================================================================
# 5. GEMINI AI CREDENTIALS
# ==============================================================================
GEMINI_API_KEY="AIzaSy...MOUNTED_FROM_SECRET_MANAGER"

# ==============================================================================
# 6. ASYNCHRONOUS PROCESSING & SCHEDULER
# ==============================================================================
# Cloud Tasks queue configuration
CLOUD_TASKS_QUEUE="invoiceready-scan-queue"
CLOUD_TASKS_LOCATION="asia-east1"

# Cloud Scheduler shared secret for retention cron execution
CRON_SECRET="STRONG_CRON_SECRET_MOUNTED_FROM_SECRET_MANAGER"

# ==============================================================================
# 7. SECURITY SCANNING
# ==============================================================================
# Optional ClamAV antivirus daemon socket connection
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
